# Dinner By Derek — copy this file to .env and fill it in.
#   cp .env.example .env
# Never commit .env. It holds the password and the encryption key.

# --- Required -----------------------------------------------------------
# The password for the /admin dashboard, stored hashed. Make the line with:
#   npm run password
# It asks twice, shows nothing as you type, and prints the line to paste
# here. Then delete ADMIN_PASSWORD below — the hash is what gets used, and a
# plaintext copy sitting next to it is the one that leaks.
ADMIN_PASSWORD_HASH=

# The same password in the clear. Only read when ADMIN_PASSWORD_HASH is empty.
# Fine on a laptop; on a real server anyone who can read this file — a backup,
# a screen share, a copy on the wrong machine — has the dashboard.
ADMIN_PASSWORD=

# Signs the login cookie, along with the password. Any long random string.
# Changing either one signs everyone out, which is how you kill a session on
# a phone you no longer have.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Where the site lives ------------------------------------------------
PORT=3000
# Public https address, no trailing slash. Used in emails, share links, the
# Facebook post text, and the OAuth redirect. Must be exact.
BASE_URL=http://localhost:3000

# --- Storage -------------------------------------------------------------
# Defaults are fine. All three need to survive a redeploy — put them on a
# volume, not inside the app directory, if the host wipes it on deploy.
DB_PATH=./data/dinnerbyderek.db
UPLOAD_DIR=./data/uploads
# Social graphics and the business card, made from Dashboard → Graphics.
GRAPHICS_DIR=./data/graphics

# --- Email ---------------------------------------------------------------
# Order notifications and customer confirmations. Leave blank to disable
# email entirely: orders are still saved and still appear in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_FROM is what customers see in the From line and reply to, so put it on
# the domain rather than a personal mailbox. Set BASE_URL at the same time you
# set these, or the dashboard links inside your own alert emails point at
# localhost. See "Turning email on later" in the README.

# --- Reading the bank's notifications ------------------------------------
# Interac has no API. The only signal that money arrived is the notification
# email the bank sends, so the app reads one out of a mailbox. Leave IMAP_HOST
# blank to keep this off: the Payments screen still takes a pasted
# notification, which is how it worked before this existed.
#
# This must be a mailbox of its OWN, not the address on the domain. Customers
# reply to orders@dinnerbyderek.ca, and the parser is owed an inbox that holds
# nothing but bank mail. The intended shape is a free mailbox nobody reads by
# eye, fed by a rule that forwards only the notifications into it.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Which domains a notification may come from, comma separated. This decides
# what is worth reading; it is NOT proof a message is genuine — the forward
# strips the original's DMARC result on the way through, and a From line is
# whatever the sender typed. What actually protects `paid` is the rule in
# payments.js: an order settles itself only when the reference AND the exact
# total agree. Widen this only if the bank starts sending from somewhere else.
IMAP_ALLOW_FROM=payments.interac.ca

# Check it with `npm run poll` before trusting the timer: it reads the mailbox
# once, says what it found, and changes nothing it could not explain.

# --- Facebook (optional) -------------------------------------------------
# Only needed for one-tap publishing to a Facebook Page. Without these, the
# manual copy-and-paste path still works and is the only path for Groups.
# See the README for which scopes to request and why.
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0

# Encrypts the Facebook token before it is written to the database. Required
# only if you connect Facebook. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Runtime -------------------------------------------------------------
# Set to production on the real server: long-lived static caching, and the app
# says at boot if anything is still set up the way a laptop would be.
# Secure cookies follow BASE_URL rather than this — set that to https and the
# login cookie stops travelling in the clear.
NODE_ENV=development

# Set to 1 only when nginx (or another proxy) sits in front, so the app reads
# the real visitor address instead of the proxy's. Leave it unset otherwise:
# the login limiter counts attempts per address, and a caller reachable
# directly can then name a new one on every try. Wrongly unset behind nginx is
# the safe direction — everyone shares one bucket. See the README.
# TRUST_PROXY=1
