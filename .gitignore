node_modules/
# Anchored. Unanchored, `data/` matches a directory of that name at any depth —
# which silently swallowed video/src/data/, where the QR matrix the video's
# card scene imports is generated. The file was written, ignored, and never
# committed, so `remotion bundle`, `remotion render` and `tsc` all failed on a
# clean checkout for every composition in that project. This rule is about the
# app's runtime directory at the repository root: the database, the uploads and
# the generated graphics. Nothing else.
/data/
.env
*.log

# Derek's own media stash — source artwork and phone photos kept beside the
# repo, not part of it. The good line art was copied into brand/ from here.
other local media uploads/

# Local Claude Code session state.
.claude/

# Remotion skill files, fetched by `npx skills add`. Rebuildable from
# skills-lock.json, so the copies stay out of the repo.
.agents/
